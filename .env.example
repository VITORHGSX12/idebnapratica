# Exemplos de Variáveis de Ambiente Obrigatórias
# SECURITY FIX: [Hardcode & Secrets] Nunca inclua valores de produção ou chaves reais neste arquivo

# Chave criptográfica AES de 32 bytes (64 caracteres hexadecimais)
ENCRYPTION_KEY=sua-chave-hex-de-64-caracteres-gerada-com-crypto-randomBytes-32

# Segredo criptográfico para assinatura e validação dos tokens JWT (mínimo 32 caracteres)
JWT_SECRET=seu-jwt-secret-forte-e-aleatorio-aqui-2026

# Porta do servidor
PORT=8080

# URL de Conexão com o PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Chave de Serviço Supabase (opcional para migrations e backend admin)
SUPABASE_SERVICE_KEY=sua-service-key-do-supabase
